{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@reader/*": ["../modules/notes/packages/desktop/src/features/reader/*"],
      "@app/*": ["../modules/notes/packages/desktop/src/renderer/*"]
    }
  },
  "include": ["**/*.ts"]
}
