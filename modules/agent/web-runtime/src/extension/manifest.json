{
  "manifest_version": 3,
  "name": "Noemori 浏览器连接",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "description": "将用户明确共享的 Chrome 或 Edge 页面连接到 Noemori。",
  "permissions": ["debugger", "nativeMessaging", "tabs"],
  "background": { "service_worker": "extension/background.js", "type": "module" },
  "action": { "default_popup": "extension/popup.html" },
  "key": ""
}
