{
  "name": "@nous/vault-node",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "nous-vault-node",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "PATH=\"$HOME/.cargo/bin:$(brew --prefix rustup 2>/dev/null)/bin:$PATH\" CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-../../.artifacts/target}\" napi build --platform --release",
    "build:debug": "PATH=\"$HOME/.cargo/bin:$(brew --prefix rustup 2>/dev/null)/bin:$PATH\" CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-../../.artifacts/target}\" napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
